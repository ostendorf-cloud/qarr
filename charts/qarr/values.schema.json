{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qarr",
  "type": "object",
  "required": ["image", "service"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["type", "port", "adminPort"],
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "annotations": { "type": "object" },
        "parentRefs": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the Gateway this HTTPRoute attaches to. Required when httpRoute.enabled is true; enforced by a template fail guard, not minLength, matching this chart's existing pattern for a value with no usable default."
            },
            "namespace": {
              "type": "string",
              "description": "Namespace the Gateway lives in. Required when httpRoute.enabled is true; see parentRefs.name's own description."
            },
            "sectionName": { "type": "string" }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "config": {
      "type": "object",
      "properties": {
        "listenAddr": { "type": "string", "minLength": 1 },
        "adminListenAddr": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "trustedProxies": { "type": "string" },
        "siteUrl": {
          "type": "string",
          "pattern": "^(https?://[^/@?# ]+)?$",
          "description": "Public origin of the site (SITE_URL), without path, query or fragment. Empty keeps the application default."
        },
        "umami": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^(https?://.*)?$" },
            "websiteId": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
            }
          }
        },
        "logos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directory": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(/[^\\s]*)?$",
                  "description": "Absolute path the volume is mounted at (LOGOS_DIR). Empty means no directory source."
                },
                "volume": {
                  "type": "object",
                  "description": "A Kubernetes volume source, mounted read only at path."
                }
              }
            },
            "s3": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "endpoint": { "type": "string", "pattern": "^(https?://[^/@?# ]+(/[^?# ]*)?)?$" },
                "bucket": { "type": "string", "pattern": "^[A-Za-z0-9.\\-_]*$" },
                "region": { "type": "string", "pattern": "^[A-Za-z0-9\\-_]*$" },
                "prefix": { "type": "string" },
                "existingSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "accessKeyIdKey": { "type": "string", "minLength": 1 },
                    "secretAccessKeyKey": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
