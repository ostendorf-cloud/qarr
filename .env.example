# Copy to .env and fill in what you need; docker-compose.yaml reads it.
# Every value here has a usable default; qarr starts with none of them set.

# ADDR=:8080
# ADMIN_ADDR=:8081
# LOG_LEVEL=info

# Page view counting through Umami, reported from the server. Off unless both
# UMAMI_URL and UMAMI_WEBSITE_ID are set; one alone stops the start. Neither
# value is a secret.
# UMAMI_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000000
# Public origin without path. Canonical links, the sitemap and the Umami
# hostname (its bare host) come from it.
# SITE_URL=https://qarr.de
# Comma separated CIDRs of the proxies in front of qarr. Without it, behind a
# proxy, no view is counted.
# TRUSTED_PROXIES=

# Preset logos, served under qarr's own origin. Neither source is required: with
# none set the page offers upload only. Set one source, a directory or a bucket,
# never both. docker-compose.yaml passes none of these on, add them to its
# environment block and mount the directory as a volume when you need them.
# LOGOS_DIR=/logos
# LOGOS_S3_ENDPOINT=https://s3.example.com
# LOGOS_S3_BUCKET=qarr-logos
# Signing region. Defaults to us-east-1.
# LOGOS_S3_REGION=us-east-1
# Only keys below this prefix are listed.
# LOGOS_S3_PREFIX=brand/
# A read-only key pair. Each has a _FILE twin holding the path of a file with the
# value, which keeps the key out of the process environment. Set one or the other.
# LOGOS_S3_ACCESS_KEY_ID_FILE=/run/secrets/logos-access-key-id
# LOGOS_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/logos-secret-access-key
